{
  "name": "usesetu-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "UseSetu - Platform Workspace containing Backend & Frontend",
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm run build:backend && npm run build:frontend",
    "lint:backend": "npm --prefix backend run lint",
    "lint:fix:backend": "npm --prefix backend run lint:fix",
    "format:backend": "npm --prefix backend run format",
    "seed:essential": "npm --prefix backend run seed:essential",
    "seed:super-admin": "npm --prefix backend run seed:super-admin",
    "migrate:tenants": "npm --prefix backend run migrate:tenants",
    "migrate:stage5": "npm --prefix backend run migrate:stage5",
    "job:reminders": "npm --prefix backend run job:reminders",
    "job:snapshot-analytics": "npm --prefix backend run job:snapshot-analytics",
    "start:backend": "npm --prefix backend start"
  }
}
