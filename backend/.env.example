# ── App ───────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ──────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/csc-os

# ── JWT ───────────────────────────────────────────────
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ── Cookies ───────────────────────────────────────────
COOKIE_SECRET=replace_with_a_random_string

# ── Client ────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── Brevo (Email) ────────────────────────────────────
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=CSC OS

# ── ImageKit ──────────────────────────────────────────
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# ── Rate Limiting ─────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── OTP / Account Lockout ────────────────────────────
OTP_EXPIRY_MINUTES=10
ACCOUNT_LOCK_MAX_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MINUTES=30

# ── Super Admin Seed (used only by seed:super-admin script) ─
SEED_SUPER_ADMIN_NAME=Super Admin
SEED_SUPER_ADMIN_EMAIL=superadmin@cscos.local
SEED_SUPER_ADMIN_MOBILE=9999999999
SEED_SUPER_ADMIN_PASSWORD=ChangeMe@123

# ── Request Management ────────────────────────────────
APPLICATION_NUMBER_PREFIX=CSC

# ── Platform Domains ──────────────────────────────────
PLATFORM_BASE_DOMAIN=usesetu.com
PLATFORM_PROTOCOL=https
CUSTOM_DOMAIN_CNAME_TARGET=domains.usesetu.com
CUSTOM_DOMAIN_VERIFICATION_PREFIX=_usesetu-verification

# ── Razorpay Payment Gateway (Stage 7) ────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_ACCOUNT_NAME=UseSetu Cloud
RAZORPAY_CURRENCY=INR
RAZORPAY_MODE=test
RAZORPAY_BILLING_MODE=order
